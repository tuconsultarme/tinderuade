# UADencuentros — copiar a .env.local y completar.
# .env.local está en .gitignore: nunca se commitea.

# El front es una SPA con Vite, así que las variables que llegan al navegador
# llevan prefijo VITE_ (antes el plan era Next.js y usaban NEXT_PUBLIC_).
VITE_SUPABASE_URL=https://wlhcppxjxnhpzontjabf.supabase.co

# Settings → API → "anon public". Va al navegador, es pública por diseño:
# lo que la contiene es la RLS, no el secreto.
VITE_SUPABASE_ANON_KEY=

# Settings → API → "service_role". Saltea la RLS entera.
# NO la uses en esta app: no hay servidor donde esconderla. Queda listada solo
# para scripts de mantenimiento que corras a mano desde tu máquina.
SUPABASE_SERVICE_ROLE_KEY=
